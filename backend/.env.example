# ─── Server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────
# Tu dominio de Vercel o localhost para desarrollo
ALLOWED_ORIGINS=http://localhost:3000,https://tu-app.vercel.app

# ─── Firebase Admin ───────────────────────────────────
# Opción A: ruta al archivo JSON descargado de Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Opción B: variables individuales (recomendado para Railway/Render)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
# La private key debe estar en una sola línea con \n escapados
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ─── API-Football ─────────────────────────────────────
# https://www.api-football.com → registro gratuito → API key
API_FOOTBALL_KEY=tu_api_key_aqui
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# ID de la temporada del Mundial (2026 para FIFA World Cup)
WORLD_CUP_LEAGUE_ID=1
WORLD_CUP_SEASON=2026

# ─── Cron ─────────────────────────────────────────────
# Cada cuántos minutos sincronizar resultados (5 = cada 5 min)
SYNC_INTERVAL_MINUTES=5

# ─── Admin ────────────────────────────────────────────
# UID de Firebase del admin que puede forzar sincronización manual
ADMIN_UID=firebase_uid_del_admin
